<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HB MedPrep | MDCAT practice, tests and aggregate calculator</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--ink:#0c2a2f;--teal:#0f8b8d;--mint:#e4f3f1;--paper:#f6faf9;--amber:#f2b441;--red:#d64550;--line:#cfe3e0}
*{box-sizing:border-box;margin:0}
body{font-family:Figtree,system-ui,sans-serif;background:var(--paper);color:var(--ink);line-height:1.55}
h1,h2,.logo{font-family:'Bricolage Grotesque',Figtree,sans-serif;letter-spacing:-.02em}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
header{display:flex;justify-content:space-between;align-items:center;padding:18px 0}
.logo{font-weight:800;font-size:22px}.logo b{background:var(--ink);color:#fff;border-radius:8px;padding:2px 8px;margin-right:6px}
.btn{display:inline-block;border:0;border-radius:12px;padding:12px 20px;font:600 15px Figtree,sans-serif;cursor:pointer;background:var(--teal);color:#fff;text-decoration:none}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.btn:focus-visible,input:focus-visible,.opt:focus-visible,.pal button:focus-visible{outline:3px solid var(--amber);outline-offset:2px}
.hero{display:grid;grid-template-columns:1.05fr 1fr;gap:40px;align-items:center;padding:30px 0 70px}
h1{font-size:clamp(34px,5.4vw,60px);line-height:1.02;font-weight:800}
.hero p{font-size:18px;margin:18px 0 26px;max-width:46ch}
.cta{display:flex;gap:12px;flex-wrap:wrap}
.exam{background:#fff;border:1.5px solid var(--ink);border-radius:20px;box-shadow:8px 8px 0 var(--ink);padding:18px}
.bar{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-weight:600;font-size:14px}
.timer{font:800 20px 'Bricolage Grotesque',sans-serif;background:var(--mint);padding:4px 12px;border-radius:10px}
.timer.low{background:var(--red);color:#fff}
.prog{height:6px;background:var(--mint);border-radius:9px;overflow:hidden;margin-bottom:14px}
.prog i{display:block;height:100%;background:var(--teal);width:0;transition:width .3s}
.q{font-size:18px;font-weight:600;margin-bottom:12px;min-height:56px}
.opt{display:block;width:100%;text-align:left;background:var(--paper);border:1.5px solid var(--line);border-radius:12px;padding:11px 14px;margin-bottom:8px;font:500 15px Figtree,sans-serif;cursor:pointer;color:var(--ink)}
.opt.sel{border-color:var(--teal);background:var(--mint);font-weight:600}
.nav{display:flex;gap:8px;margin:12px 0}
.nav .btn{padding:10px 14px;font-size:14px;flex:1}
.pal{display:flex;gap:8px;flex-wrap:wrap}
.pal button{width:38px;height:38px;border-radius:10px;border:1.5px solid var(--line);background:#fff;font:600 14px Figtree;cursor:pointer;color:var(--ink)}
.pal .done{background:var(--teal);color:#fff;border-color:var(--teal)}
.pal .skip{background:var(--amber);border-color:var(--amber)}
.pal .cur{outline:2.5px solid var(--ink)}
.result{text-align:center;padding:24px 8px}.result strong{font:800 44px 'Bricolage Grotesque'}
section{padding:60px 0}
h2{font-size:clamp(28px,4vw,42px);font-weight:800;margin-bottom:8px}
.calc{display:grid;grid-template-columns:1fr 1fr;gap:30px;margin-top:26px;background:var(--ink);color:#fff;border-radius:26px;padding:30px}
.calc label{display:block;font-size:14px;margin:12px 0 4px;color:#b9d6d3}
.row{display:flex;gap:10px}
input{width:100%;padding:12px;border-radius:12px;border:1.5px solid #2b5157;background:#12373d;color:#fff;font:600 17px Figtree,sans-serif}
.gauge{display:grid;place-items:center;position:relative}
.gauge svg{width:min(100%,280px);transform:rotate(-90deg)}
.gauge circle{fill:none;stroke-width:16;stroke-linecap:round}
#ring{stroke:var(--amber);stroke-dasharray:540;stroke-dashoffset:540;transition:stroke-dashoffset .9s cubic-bezier(.2,.8,.2,1)}
.gauge div{position:absolute;text-align:center}.gauge b{font:800 52px 'Bricolage Grotesque';display:block;line-height:1}
.note{font-size:13px;color:#b9d6d3;margin-top:14px}
.feat{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:24px}
.feat div{border-top:3px solid var(--teal);padding-top:12px}.feat h3{font-size:18px;margin-bottom:4px}
footer{padding:30px 0 50px;font-size:14px;border-top:1px solid var(--line)}
@media(max-width:820px){.hero,.calc,.feat{grid-template-columns:1fr}.exam{box-shadow:5px 5px 0 var(--ink)}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<div class="wrap">
<header><div class="logo"><b>HB</b>MedPrep</div><a class="btn" href="#login">Log in</a></header>

<div class="hero">
<div>
<h1>Practise MDCAT the way the real test feels.</h1>
<p>Chapter-wise MCQs for Class XI and XII, timed mock tests, and a clear result after every attempt. Start free with your Gmail.</p>
<div class="cta"><a class="btn" href="#login">Start free test</a><a class="btn ghost" href="#aggregate">Calculate aggregate</a></div>
</div>
<div class="exam" aria-label="Sample test">
<div class="bar"><span id="qn">Question 1 of 5</span><span class="timer" id="timer">05:00</span></div>
<div class="prog"><i id="prog"></i></div>
<div class="q" id="qt"></div>
<div id="opts"></div>
<div class="nav"><button class="btn ghost" id="prev">Previous</button><button class="btn ghost" id="skip">Skip</button><button class="btn" id="next">Next</button></div>
<div class="pal" id="pal"></div>
<div class="nav"><button class="btn ghost" id="exit">Exit test</button><button class="btn" id="submit">Submit</button></div>
</div>
</div>

<section id="aggregate">
<h2>Aggregate calculator</h2>
<p>Enter your marks and see your merit aggregate update live.</p>
<div class="calc">
<div>
<label>Matric marks (obtained / total)</label><div class="row"><input id="m1" type="number" inputmode="numeric" value="900"><input id="m2" type="number" inputmode="numeric" value="1100"></div>
<label>FSc marks (obtained / total)</label><div class="row"><input id="f1" type="number" inputmode="numeric" value="850"><input id="f2" type="number" inputmode="numeric" value="1100"></div>
<label>MDCAT marks (out of 200)</label><input id="d1" type="number" inputmode="numeric" value="166">
<p class="note">Weights used: Matric 10%, FSc 40%, MDCAT 50%. Check the latest PM&amp;DC notice, as these can change.</p>
</div>
<div class="gauge"><svg viewBox="0 0 200 200"><circle cx="100" cy="100" r="86" stroke="#1d474d"/><circle id="ring" cx="100" cy="100" r="86"/></svg><div><b id="agg">0.00</b>aggregate %</div></div>
</div>
</section>

<section id="login">
<h2>What you get</h2>
<div class="feat">
<div><h3>Free and paid tests</h3><p>Try free chapter tests first. Unlock full mock series when you are ready.</p></div>
<div><h3>Results by email</h3><p>Your mock test result is sent to your Gmail, with wrong answers to review.</p></div>
<div><h3>Weak-chapter report</h3><p>See which chapters cost you marks and practise them again.</p></div>
</div>
</section>
<footer>HB MedPrep. About us, plans, how to pay and contact pages come next.</footer>
</div>

<script>
const Q=[
["Which organelle produces most of the cell's ATP?",["Ribosome","Mitochondrion","Golgi body","Lysosome"],1],
["What is the SI unit of force?",["Joule","Pascal","Newton","Watt"],2],
["What is the atomic number of carbon?",["4","6","8","12"],1],
["Which vitamin is made in skin with sunlight?",["Vitamin A","Vitamin C","Vitamin D","Vitamin K"],2],
["Choose the correct spelling.",["Occurence","Occurrence","Ocurrence","Occurrance"],1]];
let i=0,ans=Array(Q.length).fill(-1),seen=Array(Q.length).fill(false),t=300,tick,done=false;
const $=id=>document.getElementById(id);
function render(){
 seen[i]=true;const q=Q[i];
 $('qn').textContent='Question '+(i+1)+' of '+Q.length;$('qt').textContent=q[0];
 $('opts').innerHTML=q[1].map((o,k)=>'<button class="opt'+(ans[i]===k?' sel':'')+'" data-k="'+k+'">'+o+'</button>').join('');
 document.querySelectorAll('.opt').forEach(b=>b.onclick=()=>{if(done)return;ans[i]=+b.dataset.k;render()});
 $('pal').innerHTML=Q.map((_,k)=>'<button data-k="'+k+'" class="'+(k===i?'cur ':'')+(ans[k]>-1?'done':(seen[k]&&k!==i?'skip':''))+'" aria-label="Go to question '+(k+1)+'">'+(k+1)+'</button>').join('');
 document.querySelectorAll('.pal button').forEach(b=>b.onclick=()=>{if(!done){i=+b.dataset.k;render()}});
 $('prog').style.width=(ans.filter(a=>a>-1).length/Q.length*100)+'%';
}
function clock(){const m=String(Math.floor(t/60)).padStart(2,'0'),s=String(t%60).padStart(2,'0');$('timer').textContent=m+':'+s;$('timer').classList.toggle('low',t<=60)}
function start(){done=false;i=0;ans.fill(-1);seen.fill(false);t=300;clearInterval(tick);tick=setInterval(()=>{t--;clock();if(t<=0)finish()},1000);clock();$('qt').parentNode.querySelectorAll('.nav,.pal,.prog,.bar').forEach(e=>e.style.display='');const r=document.querySelector('.result');if(r)r.remove();$('opts').style.display='';$('qt').style.display='';render()}
function finish(){
 done=true;clearInterval(tick);
 const sc=ans.reduce((a,v,k)=>a+(v===Q[k][2]?1:0),0);
 document.querySelectorAll('.exam .nav,.pal,.prog,.bar').forEach(e=>e.style.display='none');
 $('opts').style.display='none';$('qt').style.display='none';
 const d=document.createElement('div');d.className='result';
 d.innerHTML='<strong>'+sc+' / '+Q.length+'</strong><p>Your result will be emailed to your Gmail after the mock test.</p><button class="btn" id="again">Try again</button>';
 $('qt').after(d);$('again').onclick=start;
}
$('next').onclick=()=>{if(!done&&i<Q.length-1){i++;render()}};
$('prev').onclick=()=>{if(!done&&i>0){i--;render()}};
$('skip').onclick=()=>{if(!done&&i<Q.length-1){i++;render()}};
$('submit').onclick=finish;
$('exit').onclick=()=>{if(confirm('Leave this test? Your answers will be lost.'))start()};
start();

let shown=0;
function calc(){
 const v=id=>parseFloat($(id).value)||0,cl=(a,b)=>b>0?Math.min(a/b,1):0;
 const r=cl(v('m1'),v('m2'))*10+cl(v('f1'),v('f2'))*40+cl(v('d1'),200)*50;
 $('ring').style.strokeDashoffset=540-540*r/100;
 const from=shown,t0=performance.now();
 (function step(n){const p=Math.min((n-t0)/800,1);shown=from+(r-from)*(1-Math.pow(1-p,3));$('agg').textContent=shown.toFixed(2);if(p<1)requestAnimationFrame(step)})(t0);
}
['m1','m2','f1','f2','d1'].forEach(id=>$(id).addEventListener('input',calc));
calc();
</script>
</body>
</html>
